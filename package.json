{
  "private": true,
  "scripts": {
    "build": "spago build -p free",
    "build:benchmark": "spago build -p free-benchmark",
    "test": "spago test -p free",
    "test:benchmark": "node --expose-gc --max-old-space-size=2560 --max-semi-space-size=8 --input-type=module -e \"import { main } from './output/Benchmark.Main/index.js'; main()\"",
    "format": "purs-tidy format-in-place src test benchmark/src && oxfmt --write .",
    "format:check": "purs-tidy check src test benchmark/src && oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.1",
    "spago": "^1.0.5"
  }
}
