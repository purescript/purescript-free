{
  "private": true,
  "scripts": {
    "build": "spago build -p free",
    "build:benchmark": "spago build -p free-benchmark",
    "test": "spago test -p free",
    "test:benchmark": "NODE_OPTIONS='--expose-gc --max-old-space-size=2560' spago run -p free-benchmark",
    "format": "purs-tidy format-in-place src test benchmark/src && oxfmt --write .",
    "format:check": "purs-tidy check src test benchmark/src && oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.1",
    "spago": "^1.0.5"
  }
}
